<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.grupo18</groupId>
        <artifactId>eSportsArenaManager</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>arena-web</artifactId>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>2025.1.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-hateoas</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.2</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>../msvc-game-service/src/main/resources</directory>
                <targetPath>demo/game</targetPath>
                <includes><include>data.sql</include></includes>
            </resource>
            <resource>
                <directory>../msvc-match-service/src/main/resources</directory>
                <targetPath>demo/match</targetPath>
                <includes><include>data.sql</include></includes>
            </resource>
            <resource>
                <directory>../msvc-notification-service/src/main/resources</directory>
                <targetPath>demo/notification</targetPath>
                <includes><include>data.sql</include></includes>
            </resource>
            <resource>
                <directory>../msvc-prize-service/src/main/resources</directory>
                <targetPath>demo/prize</targetPath>
                <includes><include>data.sql</include></includes>
            </resource>
            <resource>
                <directory>../msvc-ranking-service/src/main/resources</directory>
                <targetPath>demo/ranking</targetPath>
                <includes><include>data.sql</include></includes>
            </resource>
            <resource>
                <directory>../msvc-registration-service/src/main/resources</directory>
                <targetPath>demo/registration</targetPath>
                <includes><include>data.sql</include></includes>
            </resource>
            <resource>
                <directory>../msvc-result-service/src/main/resources</directory>
                <targetPath>demo/result</targetPath>
                <includes><include>data.sql</include></includes>
            </resource>
            <resource>
                <directory>../msvc-sanction-service/src/main/resources</directory>
                <targetPath>demo/sanction</targetPath>
                <includes><include>data.sql</include></includes>
            </resource>
            <resource>
                <directory>../msvc-team-service/src/main/resources</directory>
                <targetPath>demo/team</targetPath>
                <includes><include>data.sql</include></includes>
            </resource>
            <resource>
                <directory>../msvc-tournament-service/src/main/resources</directory>
                <targetPath>demo/tournament</targetPath>
                <includes><include>data.sql</include></includes>
            </resource>
            <resource>
                <directory>../msvc-user-service/src/main/resources</directory>
                <targetPath>demo/user</targetPath>
                <includes><include>data.sql</include></includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>include-domain-sources</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/../msvc-auth-service/src/main/java</source>
                                <source>${project.basedir}/../msvc-game-service/src/main/java</source>
                                <source>${project.basedir}/../msvc-match-service/src/main/java</source>
                                <source>${project.basedir}/../msvc-notification-service/src/main/java</source>
                                <source>${project.basedir}/../msvc-prize-service/src/main/java</source>
                                <source>${project.basedir}/../msvc-ranking-service/src/main/java</source>
                                <source>${project.basedir}/../msvc-registration-service/src/main/java</source>
                                <source>${project.basedir}/../msvc-result-service/src/main/java</source>
                                <source>${project.basedir}/../msvc-sanction-service/src/main/java</source>
                                <source>${project.basedir}/../msvc-team-service/src/main/java</source>
                                <source>${project.basedir}/../msvc-tournament-service/src/main/java</source>
                                <source>${project.basedir}/../msvc-user-service/src/main/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.grupo18.arena_web.ArenaWebApplication</mainClass>
                    <excludes>
                        <exclude><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId></exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
